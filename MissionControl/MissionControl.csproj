<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>MissionControl</RootNamespace>
    <AssemblyName>MissionControl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <InternalsVisibleTo Include="MissionControl.Tests" />
    <Content Include="Assets/sample-map.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
